---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('man-linux');
const esChapters = chapters.filter(c => c.id.startsWith('es/'));
---

<BaseLayout title="Manual de Linux | dap.gal" description="Manual integral de administración de sistemas GNU/Linux en 12 módulos prácticos." lang="es">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="border-b border-slate-800 pb-6 mb-8">
      <span class="text-xs font-mono font-bold text-indigo-400 uppercase">Documentación</span>
      <h1 class="text-3xl font-black text-white mt-1">Manual de Linux</h1>
      <p class="text-slate-400 text-sm mt-2">12 módulos organizados para dominar la administración de servidores Linux.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {esChapters.map(chap => {
        const slug = chap.id.replace(/^es\//, '').replace(/\.md$/, '');
        return (
          <a href={`/man-linux/${slug}/`} class="p-4 rounded-xl border border-slate-800 bg-[#16181f] hover:border-indigo-500/50 hover:bg-[#1a1d26] transition-all group">
            <span class="text-[10px] font-mono text-indigo-400 font-bold block">{chap.data.moduleTitle || 'Módulo'}</span>
            <h2 class="text-base font-bold text-white group-hover:text-indigo-300 transition-colors mt-1">{chap.data.title}</h2>
            <p class="text-xs text-slate-400 mt-2 line-clamp-2">{chap.data.description}</p>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
