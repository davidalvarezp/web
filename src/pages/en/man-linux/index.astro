---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('man-linux');
const enChapters = chapters.filter(c => c.id.startsWith('en/'));
---

<BaseLayout title="Linux Manual | davidalvarezp.com" description="Comprehensive Linux systems administration handbook in 12 practical modules." lang="en">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="border-b border-slate-800 pb-6 mb-8">
      <span class="text-xs font-mono font-bold text-indigo-400 uppercase">Documentation</span>
      <h1 class="text-3xl font-black text-white mt-1">Linux Manual</h1>
      <p class="text-slate-400 text-sm mt-2">12 structured modules to master Linux server administration.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {enChapters.map(chap => {
        const slug = chap.id.replace(/^en\//, '').replace(/\.md$/, '');
        return (
          <a href={`/en/man-linux/${slug}/`} class="p-4 rounded-xl border border-slate-800 bg-[#16181f] hover:border-indigo-500/50 hover:bg-[#1a1d26] transition-all group">
            <span class="text-[10px] font-mono text-indigo-400 font-bold block">{chap.data.moduleTitle || 'Module'}</span>
            <h2 class="text-base font-bold text-white group-hover:text-indigo-300 transition-colors mt-1">{chap.data.title}</h2>
            <p class="text-xs text-slate-400 mt-2 line-clamp-2">{chap.data.description}</p>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>
