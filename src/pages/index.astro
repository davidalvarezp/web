---
// Página de Inicio replicando la identidad visual oficial de dap.gal
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="David Álvarez | dap.gal" description="Administro sistemas, construyo infraestructura y documento mi proceso. Este es mi espacio personal: técnico, abierto y en constante evolución." lang="es">
  <section class="min-h-[80vh] flex flex-col items-center justify-center text-center px-4 relative overflow-hidden">
    <div class="space-y-6 max-w-2xl">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
        dap.gal
      </span>
      <h1 class="text-5xl sm:text-7xl font-black text-white tracking-tight">
        David Álvarez
      </h1>
      <p class="text-lg font-mono font-bold text-emerald-400">
        SysAdmin · CyberSec · DevOps
      </p>
      <p class="text-slate-400 text-sm leading-relaxed max-w-xl mx-auto">
        Administro sistemas, construyo infraestructura y documento mi proceso. Este es mi espacio personal: técnico, abierto y en constante evolución.
      </p>
      <div class="flex items-center justify-center gap-4 pt-4">
        <a href="/man-linux/" class="px-5 py-2.5 rounded-lg bg-emerald-500 text-slate-950 font-bold text-xs hover:bg-emerald-400 transition-colors">
          Manual de Linux
        </a>
        <a href="/blog/" class="px-5 py-2.5 rounded-lg bg-indigo-600 text-white font-bold text-xs hover:bg-indigo-500 transition-colors">
          Blog Técnico
        </a>
        <a href="/homelab/" class="px-5 py-2.5 rounded-lg border border-slate-700 text-slate-300 font-medium text-xs hover:bg-slate-800 transition-colors">
          Homelab
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
