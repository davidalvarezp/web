---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import '../styles/material-theme.css';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  categoryTitle: string;
  headings?: { depth: number; slug: string; text: string }[];
  lastUpdated?: string;
  canonicalUrl?: string;
  alternateUrl?: string;
}

const {
  title,
  description,
  lang = 'es',
  categoryTitle,
  headings = [],
  lastUpdated,
  canonicalUrl,
  alternateUrl,
} = Astro.props;

const currentDomain = lang === 'es' ? 'dap.gal' : 'davidalvarezp.com';
const currentUrl = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang={lang} data-theme="slate" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {lang === 'es' ? "davidalvarezp's Docs" : "David Alvarez Docs"}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl || `https://${currentDomain}${currentUrl}`} />
    {alternateUrl && (
      <link 
        rel="alternate" 
        hreflang={lang === 'es' ? 'en' : 'es'} 
        href={alternateUrl} 
      />
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Fuentes Material: Roboto & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#1e2129] text-slate-200 antialiased font-['Roboto',sans-serif] selection:bg-indigo-500 selection:text-white">
    <!-- Header principal idéntico a MkDocs Material -->
    <Header lang={lang} currentPath={currentUrl} />

    <!-- Barra de pestañas / Categorías superiores -->
    <nav class="bg-[#272b36] border-b border-slate-700/60 sticky top-14 z-30 hidden md:block">
      <div class="max-w-7xl mx-auto px-4 flex items-center gap-1 overflow-x-auto text-sm">
        <a href={lang === 'es' ? '/docs/homelab' : '/en/docs/homelab'} class="px-4 py-2.5 font-medium text-indigo-400 border-b-2 border-indigo-400">Homelab</a>
        <a href={lang === 'es' ? '/docs/sistemas' : '/en/docs/sistemas'} class="px-4 py-2.5 font-medium text-slate-300 hover:text-white transition-colors">{lang === 'es' ? 'Sistemas' : 'Systems'}</a>
        <a href={lang === 'es' ? '/docs/ciberseguridad' : '/en/docs/ciberseguridad'} class="px-4 py-2.5 font-medium text-slate-300 hover:text-white transition-colors">{lang === 'es' ? 'Ciberseguridad' : 'Cybersecurity'}</a>
        <a href={lang === 'es' ? '/docs/devsecops' : '/en/docs/devsecops'} class="px-4 py-2.5 font-medium text-slate-300 hover:text-white transition-colors">DevSecOps</a>
        <a href={lang === 'es' ? '/blog' : '/en/blog'} class="px-4 py-2.5 font-medium text-slate-300 hover:text-white transition-colors">Blog</a>
      </div>
    </nav>

    <!-- Contenedor 3 Columnas MkDocs Material -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Sidebar Izquierdo: Árbol de Navegación -->
        <aside class="hidden lg:block lg:col-span-3 sticky top-28 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pr-4 border-r border-slate-800">
          <Sidebar lang={lang} currentPath={currentUrl} />
        </aside>

        <!-- Contenido Central: Artículo con Breadcrumbs y Admonitions -->
        <main class="lg:col-span-6 min-w-0">
          <div class="text-xs text-slate-400 flex items-center gap-2 mb-3">
            <span>{lang === 'es' ? 'Documentación' : 'Documentation'}</span>
            <span>/</span>
            <span class="text-indigo-400">{categoryTitle}</span>
          </div>

          <h1 class="text-3xl font-bold text-white tracking-tight mb-4">{title}</h1>
          <p class="text-slate-400 text-lg leading-relaxed mb-6 border-b border-slate-800 pb-6">{description}</p>

          <article class="prose prose-invert prose-indigo max-w-none prose-pre:bg-[#181a1f] prose-pre:border prose-pre:border-slate-800">
            <slot />
          </article>

          {lastUpdated && (
            <div class="mt-12 pt-6 border-t border-slate-800 flex justify-between items-center text-xs text-slate-500">
              <span>{lang === 'es' ? 'Última actualización:' : 'Last updated:'} {lastUpdated}</span>
              <a href="https://github.com/davidalvarezp/docs" target="_blank" class="hover:text-indigo-400 transition-colors">
                {lang === 'es' ? 'Editar esta página en GitHub' : 'Edit this page on GitHub'}
              </a>
            </div>
          )}
        </main>

        <!-- Sidebar Derecho: Table of Contents (TOC) con scrollspy -->
        <aside class="hidden lg:block lg:col-span-3 sticky top-28 self-start max-h-[calc(100vh-8rem)] overflow-y-auto pl-4">
          <TableOfContents headings={headings} lang={lang} />
        </aside>

      </div>
    </div>
  </body>
</html>