---
// src/layouts/BaseLayout.astro
const pathname = Astro.url.pathname;

// Eliminar cualquier prefijo /es o /en si existiera en el renderizado
const cleanPath = pathname.replace(/^\/(es|en)/, '') || '';

const esUrl = `https://dap.gal${cleanPath}`;
const enUrl = `https://davidalvarezp.com${cleanPath}`;

const { lang = 'es', title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Canonical dinámico según el dominio -->
  <link rel="canonical" href={lang === 'es' ? `${esUrl}` : `${enUrl}`} />

  <!-- Hreflang Tags para SEO Internacional -->
  <link rel="alternate" hreflang="es" href={esUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={enUrl} />
</head>
<body>
  <slot />
</body>
</html>