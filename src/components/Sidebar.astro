---
// src/components/Sidebar.astro
const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---
<nav class="text-xs space-y-6">
  <div>
    <div class="font-bold text-slate-300 uppercase tracking-wider text-[11px] mb-2 text-indigo-400">
      {isEs ? 'Manual de Linux' : 'Linux Manual'}
    </div>
    <ul class="space-y-1 text-slate-400">
      <li>
        <a href={isEs ? '/man-linux/' : '/en/man-linux/'} class="block py-1 hover:text-white transition-colors">
          {isEs ? 'Índice de Módulos (01 al 12)' : 'Modules Index (01 to 12)'}
        </a>
      </li>
    </ul>
  </div>

  <div>
    <div class="font-bold text-slate-300 uppercase tracking-wider text-[11px] mb-2 text-indigo-400">
      {isEs ? 'Secciones y Artículos' : 'Sections & Articles'}
    </div>
    <ul class="space-y-1 text-slate-400">
      <li>
        <a href={isEs ? '/blog/' : '/en/blog/'} class="block py-1 hover:text-white transition-colors">
          Blog
        </a>
      </li>
      <li>
        <a href={isEs ? '/homelab/' : '/en/homelab/'} class="block py-1 hover:text-white transition-colors">
          Homelab Specs
        </a>
      </li>
    </ul>
  </div>
</nav>