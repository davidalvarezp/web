---
// src/components/Header.astro
const { lang = 'es' } = Astro.props;
const currentPath = Astro.url.pathname;
const isEs = lang === 'es';

const cleanPath = currentPath.replace(/^\/(es|en)/, '') || '/';
const targetUrl = isEs
  ? `https://davidalvarezp.com${cleanPath}`
  : `https://dap.gal${cleanPath}`;

const targetLabel = isEs ? 'English' : 'Español';
---

<header class="bg-[#181a20] border-b border-slate-800 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href={isEs ? '/' : '/en/'} class="flex items-center gap-2 font-bold text-white hover:text-indigo-400 transition-colors">
        <span class="w-8 h-8 rounded bg-indigo-600 flex items-center justify-center font-mono text-sm text-white font-black">
          dap
        </span>
        <span class="text-sm font-mono tracking-tight">{isEs ? 'dap.gal' : 'davidalvarezp.com'}</span>
      </a>

      <nav class="hidden md:flex items-center gap-1 text-xs">
        <a href={isEs ? '/man-linux/' : '/en/man-linux/'} class="px-3 py-1.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition-colors">
          {isEs ? 'Manual Linux' : 'Linux Manual'}
        </a>
        <a href={isEs ? '/blog/' : '/en/blog/'} class="px-3 py-1.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition-colors">
          Blog
        </a>
        <a href={isEs ? '/homelab/' : '/en/homelab/'} class="px-3 py-1.5 rounded hover:bg-slate-800 text-slate-300 hover:text-white transition-colors">
          Homelab
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <!-- Selector de Idioma y Dominio -->
      <div class="flex items-center bg-slate-900 border border-slate-800 rounded p-0.5 text-xs font-mono">
        <a 
          href={currentPath.replace(/^\/en/, '') || '/'} 
          class={`px-2.5 py-1 rounded transition-colors ${isEs ? 'bg-indigo-600 text-white font-bold' : 'text-slate-400 hover:text-slate-200'}`}
          title="Ver versión en español (dap.gal)"
        >
          ES
        </a>
        <a 
          href={`/en${currentPath.startsWith('/en') ? currentPath.replace(/^\/en/, '') : (currentPath === '/' ? '' : currentPath)}`} 
          class={`px-2.5 py-1 rounded transition-colors ${!isEs ? 'bg-indigo-600 text-white font-bold' : 'text-slate-400 hover:text-slate-200'}`}
          title="View English version (davidalvarezp.com)"
        >
          EN
        </a>
      </div>

      <a href="https://github.com/davidalvarezp" target="_blank" rel="noopener noreferrer" class="p-1.5 rounded hover:bg-slate-800 text-slate-400 hover:text-white transition-colors" title="GitHub">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
      </a>
    </div>
  </div>
  <a href={targetUrl} class="lang-switch-btn">
    {targetLabel}
  </a>
</header>